  "repository": {
    "type": "git",
    "url": "git+https://github.com/GhabiX/pi-btw-cached.git"
  },
  "bugs": {
    "url": "https://github.com/GhabiX/pi-btw-cached/issues"
  },
  "homepage": "https://github.com/GhabiX/pi-btw-cached#readme",
  "pi": {
    "extensions": [
      "./extensions/btw.ts"
    ],
    "image": "https://raw.githubusercontent.com/GhabiX/pi-btw-cached/main/media/btw.gif"
  },
  "files": [
    "extensions",
    "README.md",
